---
version: v1alpha1
machine:
  ca:
    crt: {{ ENV.MACHINE_CA_CRT }}
  features:
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    rbac: true
  # Talos service logs go to the Vector DaemonSet on each node
  logging:
    destinations:
      - endpoint: tcp://127.0.0.1:6050/
        format: json_lines
  token: {{ ENV.MACHINE_TOKEN }}
cluster:
  ca:
    crt: {{ ENV.CLUSTER_CA_CRT }}
  clusterName: prodesk
  controlPlane:
    endpoint: https://192.168.1.209:6443
  token: {{ ENV.CLUSTER_TOKEN }}
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net0
selector:
  match: link.driver == "r8169"
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: net0
clientIdentifier: mac
---
apiVersion: v1alpha1
kind: ResolverConfig
searchDomains:
  domains: []
hostDNS:
  enabled: true
  forwardKubeDNSToHost: true # Requires Cilium socketLB features
  resolveMemberNames: true
---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
endpoint: https://discovery.talos.dev/
---
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: {{ ENV.CLUSTER_ID }}
clusterSecret: {{ ENV.CLUSTER_SECRET }}
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/metal-installer/{{ schematic }}:v1.14.6
provisioning:
  diskSelector:
    match: disk.transport == "nvme"
  wipe: true
---
# The SATA SSD in every node, formatted XFS and mounted at /var/mnt/longhorn
apiVersion: v1alpha1
kind: UserVolumeConfig
name: longhorn
provisioning:
  diskSelector:
    match: disk.transport == "sata" && !system_disk
  minSize: 500GB
---
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: FilesystemScrubConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 5m
---
# Talos kernel logs go to the Vector DaemonSet on each node
apiVersion: v1alpha1
kind: KmsgLogConfig
name: vector
url: tcp://127.0.0.1:6050/
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  fs.inotify.max_user_instances: "8192"
  # Reboot through the firmware, never kexec: kexec with the amdgpu driver
  # loaded leaves the Ryzen APU's GPU hung and the node dead until power-cycled
  kernel.kexec_load_disabled: "1"
  fs.inotify.max_user_watches: "1048576"
  net.core.default_qdisc: fq
  net.core.rmem_max: "67108864"
  net.core.wmem_max: "67108864"
  net.ipv4.neigh.default.gc_thresh1: "4096"
  net.ipv4.neigh.default.gc_thresh2: "8192"
  net.ipv4.neigh.default.gc_thresh3: "16384"
  net.ipv4.ping_group_range: 0 2147483647
  net.ipv4.tcp_congestion_control: bbr
  net.ipv4.tcp_fastopen: "3"
  net.ipv4.tcp_mtu_probing: "1"
  net.ipv4.tcp_notsent_lowat: "131072"
  net.ipv4.tcp_rmem: 4096 131072 67108864
  net.ipv4.tcp_slow_start_after_idle: "0"
  net.ipv4.tcp_wmem: 4096 65536 67108864
  user.max_user_namespaces: "11255"
---
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: containerd
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
  [plugins."io.containerd.cri.v1.runtime"]
    device_ownership_from_security_context = true
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 192.168.0.0/23
labels:
  topology.kubernetes.io/region: prodesk
---
apiVersion: v1alpha1
kind: KubeletConfig
config:
  crashLoopBackOff:
    maxContainerRestartPeriod: 60s
  imageMaximumGCAge: 168h
  maxParallelImagePulls: 3
  serializeImagePulls: false
  shutdownGracePeriod: 90s
  shutdownGracePeriodCriticalPods: 60s
defaultRuntimeSeccompProfileEnabled: true
image: ghcr.io/siderolabs/kubelet:v1.36.7
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
  - 10.42.0.0/16
serviceSubnets:
  - 10.43.0.0/16
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
