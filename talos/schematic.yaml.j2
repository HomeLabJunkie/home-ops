---
customization:
  extraKernelArgs:
    - sysctl.kernel.kexec_load_disabled=1 # amdgpu hangs on kexec reboots (also set in cluster.yaml.j2)
  systemExtensions:
    officialExtensions:
      - siderolabs/amd-ucode # AMD CPU microcode
      - siderolabs/amdgpu # Radeon Vega iGPU: keeps the display alive for the KVM
      - siderolabs/iscsi-tools # Longhorn
      - siderolabs/realtek-firmware # Realtek NIC firmware
      - siderolabs/util-linux-tools # Longhorn (fstrim, nsenter)
