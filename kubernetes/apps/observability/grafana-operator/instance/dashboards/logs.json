    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "victoriametrics-logs-datasource",
        "hide": 2,
        "current": {
          "text": "victoria-logs",
          "value": "victoria-logs"
        }
      },
      {
        "name": "search",
        "label": "Search (regex, case-insensitive)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "$ds"
        },
        "query": {
          "type": "fieldValue",
          "field": "kubernetes.pod_namespace",
          "query": "kubernetes.pod_namespace:*",
          "limit": 1000,
          "refId": "A"
        },
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": ["All"],
          "value": ["$__all"]
        }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "$ds"
        },
        "query": {
          "type": "fieldValue",
          "field": "kubernetes.pod_name",
          "query": "kubernetes.pod_namespace:in($namespace)",
          "limit": 1000,
          "refId": "A"
        },
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "refresh": 2,
        "sort": 1,
        "current": {
