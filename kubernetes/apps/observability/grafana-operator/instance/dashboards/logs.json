          },
          "queryType": "instant",
          "editorMode": "code",
          "expr": "_stream:{source=\"talos\"} node:in($talos_node) service:in($talos_service) level:in($talos_level) ~\"(?i)$search\"",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
