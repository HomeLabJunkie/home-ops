        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "$ds"
          },
          "queryType": "statsRange",
          "editorMode": "code",
          "expr": "kubernetes.pod_namespace:* kubernetes.pod_namespace:in($namespace) kubernetes.pod_name:in($pod) kubernetes.container_name:in($container) ~\"(?i)$search\" | stats by (kubernetes.pod_namespace) count() lines",
          "legendFormat": "{{kubernetes.pod_namespace}}"
        }
