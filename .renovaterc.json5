{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#11.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#11.0.0",
    ":timezone(America/Chicago)",
  ],
  schedule: ["every weekend"],
  // mise generates .mise/locks/** (npm package.json + lockfile per tool
  // version); Renovate's npm manager must not edit them, the mise manager
  // updates the pin in .mise/config.toml instead.
  ignorePaths: [".mise/locks/**"],
  // Main does not require up-to-date branches, and `auto` would rebase every
  // open PR each time main moves.
  rebaseWhen: "conflicted",
  packageRules: [
    {
      // Private GHCR image: Mend's hosted Renovate has no credentials for it
      // ("no docker auth found"). fb-search is shipped by hand: merge in
      // fb-marketplace-hunter, its Image workflow builds it, then bump the tag
      // and digest here.
      description: "Skip the private fb-search image",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/homelabjunkie/fb-search"],
      enabled: false,
    },
    // Grouping rules
    {
      description: "GitHub Actions Group",
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
      separateMinorPatch: true,
    },
    {
      // Unites the factory installer image, talosctl and the tuppr upgrade version
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumReleaseAge: "3 days",
    },
    {
      description: "Hold Kubernetes on 1.36 until Cilium supports 1.37",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      allowedVersions: "<1.37.0",
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
}
